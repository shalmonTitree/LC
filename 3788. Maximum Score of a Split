//Bruteforce
Time Complexity	O(n)
Space Complexity	O(n)

class Solution {
public:
    long long maximumScore(vector<int>& nums) {
        int n = nums.size();
        vector<long long>prefix(n,0);
        vector<long long>suffixmin(n);

        prefix[0] = nums[0];
        suffixmin[n-1] = nums[n-1];

        long long ans  = LLONG_MIN;
        for(int i = 1; i < n; i++)
        {
            prefix[i] = prefix[i-1] + nums[i];
        }
        for(int i = n - 2; i >= 0; i--)
        {
            suffixmin[i] = min((long long)nums[i],suffixmin[i+1]);
        }
        for(int i = 0; i < n-1; i++)
        {
            ans = max(ans,prefix[i] - suffixmin[i+1]);
        }
        return ans;
    }
};


//Optimal
class Solution {
public:
    long long maximumScore(vector<int>& nums) {
        int n = nums.size();
        long long prefix = 0;
        long long ans = INT_MIN;
        int mini = INT_MAX;

        for(auto it : nums)
        {
            prefix += it;
        }

        for(int i = n - 1; i >= 1; i--)
        {
            prefix -= nums[i];
            mini = min(mini,nums[i]);
            ans = max(ans,(long long)(prefix - mini));
        }
        return ans;


    }
};




