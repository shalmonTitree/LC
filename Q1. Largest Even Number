class Solution {
public:
    string largestEven(string s) {
        int n = s.size();
        string ans = "";
        int i = n - 1;
        while(i >= 0)
            {
              int val = s[i] - '0';
                if(val % 2 == 0)
                {
                    ans = s.substr(0, i + 1);
                    return ans;
                }
                i--;
            }
        return ans;
    }
};
